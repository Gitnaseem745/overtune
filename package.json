{
  "name": "music_player",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev:next": "next dev",
    "dev:electron": "wait-on tcp:3000 && tsup main/main.ts main/preload.ts --format cjs && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "build:next": "next build",
    "build:electron": "tsup main/main.ts main/preload.ts --format cjs",
    "build": "npm run build:next && npm run build:electron",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "start": "next start",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.overtone.app",
    "productName": "Overtone",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overtone",
      "artifactName": "Overtone-Setup-${version}.${ext}"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "lucide-react": "^1.25.0",
    "music-metadata": "^7.14.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
