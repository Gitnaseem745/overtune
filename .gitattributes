# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always have LF on checkout
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.exe binary
*.dll binary
*.node binary
*.7z binary
*.zip binary
*.db binary
*.sqlite binary
*.sqlite3 binary
